# Copy this file to .env and fill in the values.
# .env is never committed to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
METADATA_DB_NAME=bids_sql
METADATA_DB_USER=bids_user
METADATA_DB_PASSWORD=changeme
# Host used when running the CLI directly (outside Docker):
METADATA_DB_HOST=localhost
# External port Docker will bind on your host machine:
METADATA_DB_PORT=5432

# ── BIDS-SQL CLI behaviour ────────────────────────────────────────────────────
# Set to true to suppress SQLAlchemy query echo in logs
IN_PRODUCTION=false

# ── Docker: BIDS data mount ───────────────────────────────────────────────────
# Absolute path on your HOST machine to the folder containing BIDS datasets.
# Mounted read-only at /data inside the bids-sql container.
BIDS_DATA_PATH=/path/to/your/bids/data
